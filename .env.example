# ============================================================
# .env — Fill this in and keep it SECRET (never commit to git)
# Used by: docker-compose.auth.yml
# ============================================================

# ── Railway MySQL Credentials ─────────────────────────────
# Get from: Railway Dashboard → MySQL service → Variables tab
# Look for: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD
RAILWAY_MYSQL_USER=root
RAILWAY_MYSQL_PASSWORD=ctjJrJbUzeZQdAykLYMSeOJfPXNXukCP

# Auth service DB — replace <host> and <port> with Railway values
# Example: monorail.proxy.rlwy.net:12345
RAILWAY_MYSQL_URL_AUTH=mysql://root:ctjJrJbUzeZQdAykLYMSeOJfPXNXukCP@yamanote.proxy.rlwy.net:58969/railway/inkwell_auth?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ── JWT Secret ────────────────────────────────────────────
# Must be the same secret used by both api-gateway and auth-service
JWT_SECRET=inkwell-super-secret-jwt-key-must-be-256-bits-long-here

# ── Google OAuth (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=622463594939-750rrmeh25q2apo9knkeq42qhrf5c8u9.apps.googleusercontent.com
